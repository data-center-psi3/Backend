          },
          {
            "name": "region",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Norte, Nordeste, Centro-Oeste, Sudeste ou Sul."
          },
          {
            "name": "operator",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Igualdade com espaços e caixa normalizados."
          },
          {
            "name": "installationType",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Igualdade com espaços e caixa normalizados."
          }
        ],
        "responses": {
          "200": {
            "description": "Consulta calculada dinamicamente; ausentes numéricos são null.",
